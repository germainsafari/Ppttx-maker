# Copy to infra/.env and fill in. Never commit the real file.

# Shared with the Vercel app (same value there). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENGINE_TOKEN_SECRET=
# Optional comma-separated keys for scripts / server-to-server calls (X-API-Key header).
ENGINE_API_KEYS=
# Origins allowed to call the engine from a browser (your Vercel domain).
CORS_ORIGINS=https://slides.admindagency.com,http://localhost:3000
# Only needed for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
