# Public URL of the engine behind the Cloudflare tunnel (browser uploads go straight there).
ENGINE_URL=https://slides-api.admindagency.com
# Must equal ENGINE_TOKEN_SECRET on the engine. Generate with: openssl rand -hex 32
ENGINE_TOKEN_SECRET=change-me
# Team password for the web UI (entered on /login). For production prefer Cloudflare Access with Entra ID.
APP_PASSWORD=change-me
